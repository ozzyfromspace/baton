{
 "hooks": {
  "PostToolUse": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/h.py\" PostToolUse"
     }
    ]
   }
  ],
  "Stop": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/h.py\" Stop"
     }
    ]
   }
  ],
  "SessionStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/h.py\" SessionStart"
     }
    ]
   },
   {
    "hooks": [
     {
      "type": "command",
      "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/h.py\" SessionStartRewake",
      "asyncRewake": true,
      "timeout": 30
     }
    ]
   }
  ]
 },
 "permissions": {
  "allow": [
   "Bash(python3 elevate.py:*)"
  ]
 }
}